# ─────────────────────────────────────────────────────
# DATABASE
# Railway PostgreSQL — copy the connection string from
# your Railway PostgreSQL plugin → Variables → DATABASE_URL
# ─────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host:5432/railway"

# ─────────────────────────────────────────────────────
# AUTH (NextAuth.js)
# NEXTAUTH_SECRET: run `openssl rand -base64 32` to generate
# NEXTAUTH_URL: set to your Railway public domain, e.g.
#   https://your-app.up.railway.app
# ─────────────────────────────────────────────────────
NEXTAUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="https://your-app.up.railway.app"

# ─────────────────────────────────────────────────────
# AI — Anthropic Claude
# Get your key at https://console.anthropic.com
# ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-..."

# ─────────────────────────────────────────────────────
# PUBLIC APP URL (used for onboarding link generation)
# Same as NEXTAUTH_URL
# ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://your-app.up.railway.app"
NEXT_PUBLIC_APP_NAME="Client Onboarding OS"

# ─────────────────────────────────────────────────────
# LOCAL DEV ONLY
# ─────────────────────────────────────────────────────
# DATABASE_URL="file:./dev.db"   ← SQLite for local dev
# NEXTAUTH_URL="http://localhost:3000"
# NEXT_PUBLIC_APP_URL="http://localhost:3000"
